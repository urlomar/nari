# Copy to .env.local and fill in real values. DO NOT COMMIT the real file.

# Google service account used to write to the waitlist Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key from the service account JSON key file.
# Keep real newlines escaped as \n (the API code converts \\n -> \n at runtime).
# Example: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# The Google Sheet ID (the long ID in the sheet URL).
GOOGLE_SHEET_ID=
# Optional: override the range used when appending rows. Defaults to Sheet1!A:E.
GOOGLE_SHEET_RANGE=

# Resend API key used to send confirmation emails.
RESEND_API_KEY=
# From-address used for outgoing email, e.g. "Nari <onboarding@resend.dev>".
NARI_FROM_EMAIL=

# Anthropic API key used by api/analyze.ts for vision-based hair analysis.
ANTHROPIC_API_KEY=

# Airtable product catalog (api/products.ts). Personal access token needs
# data.records:read scope on the base below.
AIRTABLE_TOKEN=
# Base ID only (starts with "app") — NOT the full URL path Airtable shows
# in its browser UI (which also includes a table ID and view ID separated
# by "/"). Grab just the "app..." segment.
AIRTABLE_BASE_ID=
# Table ID (starts with "tbl") is more robust than the display name, since
# it survives Nya renaming the table. Find it in the Airtable URL bar when
# viewing the table, or via the API docs page for the base.
AIRTABLE_TABLE_NAME=

# Gates the production-accessible /debug/scoring instrument (see
# CLAUDE.md's "Scoring debug view" section). Visit /debug/scoring?key=<this
# value> to use it; any other/missing key 404s identically to a nonexistent
# route. Pick a long random string — this is a real access-control value,
# not a placeholder.
ONYAPROJECTX=
